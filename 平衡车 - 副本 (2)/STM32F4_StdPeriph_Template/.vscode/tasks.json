{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: GCC 编译",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "STM32: ST-Link 烧录",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "${workspaceFolder}/build/STM32F4_StdPeriph_Template.hex",
                "-v",
                "-rst"
            ],
            "dependsOn": "STM32: GCC 编译",
            "problemMatcher": []
        }
    ]
}
